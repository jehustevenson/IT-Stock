# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ─── Supabase (client-visible; safe to expose but still secret-adjacent) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-site.example.com

# ─── Cron authentication ─────────────────────────────────────────────────
# Generate a long random string. Cron routes reject requests without this.
CRON_SECRET=replace-with-a-long-random-string

# ─── Bootstrap admins ────────────────────────────────────────────────────
# Comma-separated list of email addresses auto-granted `admin` when their
# Supabase user_metadata.role is not set. Explicit metadata roles still win.
# Remove entries once in-app role management lands.
ADMIN_EMAILS=admin@example.com

# ─── Optional third-party keys (remove if unused) ────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Waybill approval workflow
IT_MANAGER_EMAIL=it.manager@example.com
SECURITY_MANAGER_EMAIL=security.manager@example.com
# Optional: email notifications via https://resend.com (skipped if unset)
RESEND_API_KEY=
EMAIL_FROM="ITAssetTracker <waybills@yourdomain.com>"
